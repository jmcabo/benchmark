#!/bin/sh
# vim: set filetype=conf:
#
#Benchmark for the Genius command line calculator - by JMC
#
#Run:
#       ./benchmark.genius.gel 30450
#
#Install Genius Calculator:
#       sudo apt-get install genius
#
#Note: This is actually a BASH script file that feeds the code to the Genius calculator, passing the
#      command line argument embedded in the code as a variable definition.
#
#      The Genius calculator doesn't include functions to access the command line arguments. One
#      could create a .gel file with the following shebang:
#               #!/usr/bin/genius
#      but it would have no way of receiving command line arguments.
#
#      An alternative would be to use the Genius function AskString() to have the program stop and
#      ask the user to input a string. But I don't want it to be interactive if possible.
#
#      Another alternative is to run it with the following code:
#           echo -e "args=\"$@\"\\nload benchmark.genius.gel" | genius
#      but that would require two script files, one Genius "benchmark.genius.gel" and another bash
#      script with the echo.
#
#Remarks:
#    -The Genius command line calculator has existed since 1997, and it's still being developed.
#     It also has a GUI and the ability to plot functions graphically (gnome-genius).
#     URLs:
#           "Genius Mathematics Tool and the GEL Language"
#           http://www.jirka.org/genius.html
#
#           Sources
#           http://ftp.gnome.org/pub/GNOME/sources/genius/1.0/
#
#    -Many built-in functions. The list is seen with the "help" command. There is also a longer
#     documentation in
#           /usr/share/genius/genius.txt
#     Some of the functions are internal and some others are defined in GEL extension language in:
#           /usr/share/genius/gel/
#
#    -It has arbitrary precision but calculating '2^1024' doesn't show all 309 digits at first.
#     More digits can be seen by executing:
#           MaxDigits=256
#     but although MaxDigits is limited to no more than 256, one can get unlimited digits
#     by executing:
#           MaxDigits=0
#     This way it joins the "bc -l" calculator and the "calc" calculator (apcalc package) in being
#     able to display all 309 digits of '2^1024'.
#
#    -This:
#           FullExpressions=true
#     must be executed to have the Genius calculator print expressions that span more than one line.
#
#    -To get PI with 40 decimals do:
#           MaxDigits=40
#           pi
#
#    -CTRL+D can be used to exit the calculator.
#
#    -The parameter changes like MaxDigits and FullExpressions are forgotten when closing the calculator.
#     One can create a file named:
#           ~/.geniusinit
#     with contents like:
#           MaxDigits=0
#           FullExpressions=true
#           FloatPrecision=512
#     to have them always set on startup.
#
#    -Use 'ans' or 'Ans' in an expression to recall the last evaluated expression.
#
#    -To convert to hexadecimal, octal or binary, set the IntegerOutputPrecision parameter variable
#     and type a number:
#            genius> IntegerOutputBase=16
#            = 0x10
#            genius> 43981
#            = 0xabcd
#     To convert to decimal, type a number using C notation like 0xABCD for hexa or 0777 for octal.
#     For binary, the notation is "2\1010".
#
#    -There are several internal number representations: integer, rational, float and complex.
#     Float values have their precision limited by the the parameter FloatPrecision in bits.
#     By default FloatPrecision is 128 bits.
#     So floats are not arbitrary precision but "multiple precision" instead.
#     The maximum in my installed version of Genius for FloatPrecision is 16384.
#
#    -FOR loops don't finish with the next value of the variable as C loops do, but instead with the
#     last value that was iterated on. Meaning that the value of the counter variable, after leaving the
#     loop, will be the last value iterated on. It is a bit weird because in C, and many others, one is
#     used to having a value that makes the loop condition false after the loop.
#
#    -Genius has almost the exact same speed as BC in this benchmark.
#
#
#Limitations:
#    -No way to specify an exit code. When ending the program with exit() the exit code is always 0.
#
#    -No way to access or parse command line arguments from within Genius code. That is why
#     I used a shell script to generate the code with the arguments $@ and program name $0 inserted.
#
#    -No built-in way to format a float as a string using a fixed number of decimals, or padding with
#     spaces or zeros, so I made a couple of functions to do that.
#


#Put calculator code inside GENIUS_CODE shell variable:
GENIUS_CODE=$(cat <<_EOF_


    #NAIVE implementation. horribly O(n^2), and WITHOUT using sqrt optimization (on purpose so
    #that it takes longer and is easier to benchmark. The 'sysbench' utility, uses the optimization
    #but puts the function in a loop and counts 10000 calls).
    #Returns how many prime numbers exist between 2 and n:
    function findPrimes(n) = (
        local i, j, count, noDivisors;
        count = 0;

        #For each number up to 'n':
        for i=2 to n do (
            noDivisors = true;
            for j=2 to i-1 do (  #NOT using the sqrt optimization (for easier benchmarking).
                #If i divisible by j, it wasn't a prime number:
                if i % j == 0 then (
                    noDivisors = false;
                    break;
                );
            );
            if noDivisors then (
                #The previous loop ended without divisors found. It is a prime number.
                increment count;
            );
        );

        return count;
    );


    #Version using WHILE loops. Slower than using FOR.
    function findPrimes_While(n) = (
        local i, j, count;
        count = 0;

        #For each number up to 'n':
        i = 2;
        while i <= n do (
            j = 2;
            while j < i do (  #NOT using the sqrt optimization (for easier benchmarking).
                #If i divisible by j, it wasn't a prime number:
                if i % j == 0 then (
                    break;
                );
                increment j;
            );
            if i == j then (
                #The previous loop ended without divisors found. It is a prime number.
                increment count;
            );
            increment i;
        );

        return count;
    );


    #Determine if a string is composed exclusively of digits:
    #Using this to sanitize the arguments before converting them to numeric value with Evaluate() or Parse().
    function isStringOfDigits(str) = (
        local V, c;

        #Convert string to a vector of ascii values:
        V = StringToASCII(str);

        #Check that each char is [0-9]
        for c in V do (
            if c < 0x30 or c > 0x39 then (
                return false;
            );
        );

        return true;
    );


    #Checks that a number in a string doesn't start with the '0' char, which would make it
    #be interpreted as an octal number by Evaluate() or Parse().
    function isNotOctal(str) = (
        local V;

        #Convert string to a vector of ascii values:
        V = StringToASCII(str);

        #Check that it doesn't start with '0':
        if columns(V) > 0 and V@(1) != 0x30 then (
            return true;
        );

        return false;
    );


    #Add spaces up to width to left-justify a string. If the string
    #is already bigger than width, then return it unchanged.
    function padLeft(str, width) = (
        local V, spaceCount, spaces;

        #Convert to vector to get length of string:
        V = StringToASCII(str);
        spaceCount = width - columns(V);
        spaces = "";
        for i = 1 to spaceCount do (
            spaces = spaces + " ";
        );

        return spaces + str;
    );


    #Format a float to string as fixed point with the specified number of decimals - by JMC
    #
    #This is like calling in C:
    #    sprintf(destStr, "%.3f", x)
    #for floatToFixed(x, 3)
    #
    #Examples:
    #    floatToFixed(1.234, 0)      -->  "1"
    #    floatToFixed(1.234, 2)      -->  "1.23"
    #    floatToFixed(-1.995, 2)     -->  "-2.00"
    #    floatToFixed(5, 3)          -->  "5.000"
    #    floatToFixed(-0.002, 2)     -->  "-0.00"
    #    floatToFixed(1e30, 2)       -->  "1000000000000000000000000000000.00"
    #                                     (No weird approximation errors with this algorithm.)
    #
    #Good algorithms for conversion of floats to string are found in:
    #    "How to Print Floating-Point Numbers Accurately" - 1990 - Guy Steele and Jon White.
    #but those might require an arbitrary precision integer library.
    #There is also a famous, a very long, self contained, C implementation based on that paper in:
    #    "dtoa.c" - http://www.netlib.org/fp/index.html
    #dtoa.c uses its own implementation of arbitrary precision integers, all contained in a single file.
    #Similar algorithms are already used by the language when returning a float in string form (just not
    #with a specific fixed number of decimals).
    #
    #  The algorithm below prints the number to string, and parses the exponent (if the number was big or
    #small enough to be returned with exponential notation with number->string). It applies the exponent and
    #then it adds or removes fractional digits to complete the number of requested decimals (by filling
    #with 0s or truncating and rounding).
    #  This approach is more precise than the approach of trying to extract the digits one by one by
    #shifting and truncating: Since there is no access to the binary representation of the float, and
    #since these floats are base-2, small errors would be accumulated when multiplying by 10 and
    #subtracting the integer part to shift and extract the fractional digits.
    #  So it is better to rely on the algorithm inside (number->string) for converting to base-10 digits first,
    #like the present algorithm does.
    #
    function floatToFixed(x, decimalPlaces) = (
        local E_CHAR, SPC_CHAR, SLASH_CHAR, DOT_CHAR, MINUS_CHAR, ZERO_CHAR, ONE_CHAR, FIVE_CHAR, NINE_CHAR,
              str, f, exponent, expPos, oldMaxDigits, oldFloatPrecision, isNegative, integerDigits,
              fractionalDigits, pointPos, firstDigitLeftOff, pos, carry, newChar;

        SPC_CHAR = 0x20;    # " "
        SLASH_CHAR = 0x2f;  # "/"
        E_CHAR = 0x65;      # "e"
        DOT_CHAR = 0x2e;    # "."
        MINUS_CHAR = 0x2d;  # "-"
        ZERO_CHAR = 0x30;   # "0"
        ONE_CHAR = 0x31;    # "1"
        FIVE_CHAR = 0x35;   # "5"
        NINE_CHAR = 0x39;   # "9"

        #Sub-function to create a vector of length 'count' filled with 'value' values:
        function repeat(count, value) = (
            local V, i;
            V = null;
            for i = 1 to count do (
                V@(i) = value;
            );
            return V;
        );

        #Sub-function that returns the first position of a char ascii value in a vector, or -1 if not found:
        function charIndexOf(vector, ch) = (
            local i;
            #Vectors are 1-based:
            for i = 1 to columns(vector) do (
                if vector@(i) == ch then (
                    return i;
                )
            );
            return -1;
        );

        decimalPlaces = max(0, floor(decimalPlaces));

        #Set max precision and digits before converting to string:
        oldMaxDigits = MaxDigits;
        oldFloatPrecision = FloatPrecision;
        MaxDigits = 0;  #Show all integer and fractional digits.
        FloatPrecision = 16384;  #Maximum float precision for converting to string.

        #Convert to string (actually, to a vector of ascii values. Strings are read only and not that useful):
        str = StringToASCII("" + x);

        #Turn "3/4" into "0.75", and "1 3/4" into "1.75" and reconvert to string:
        if charIndexOf(str, SLASH_CHAR) != -1 or charIndexOf(str, SPC_CHAR) != -1 then (
            str = StringToASCII("" + float(x));
        );

        #Restore precision and max digits after having converted to string:
        FloatPrecision = oldFloatPrecision;
        MaxDigits = oldMaxDigits;

        #Parse exponent:
        f = str;
        exponent = 0;
        expPos = charIndexOf(str, E_CHAR);
        if expPos != -1 then (
            f = str@(1 : expPos - 1);
            exponent = str@(expPos + 1 : columns(str));
            exponent = Parse(ASCIIToString(exponent));  #Convert to number
        );

        #Get negative sign and remove it:
        isNegative = false;
        if f@(1) == MINUS_CHAR then (
            f = f@(2 : columns(f));
            isNegative = true;
        );

        #Get decimal point position and remove it:
        integerDigits = columns(f);
        fractionalDigits = 0;
        pointPos = charIndexOf(f, DOT_CHAR);
        if pointPos != -1 then (
            integerDigits = pointPos - 1;
            f = [f@(1 : pointPos - 1), f@(pointPos + 1 : columns(f))];
            fractionalDigits = columns(f) - integerDigits;
        );

        #Shift according to exponent:
        fractionalDigits = fractionalDigits - exponent;
        integerDigits = integerDigits + exponent;
        if exponent < 0 and integerDigits < 1 then (
            f = [repeat(1 - integerDigits, ZERO_CHAR), f];
            integerDigits = 1;
        ) else (
            if exponent > 0 and fractionalDigits < 0 then (
                f = [f, repeat(-fractionalDigits, ZERO_CHAR)];
                fractionalDigits = 0;
            );
        );

        #Add 0's up to decimalPlaces if we have less than asked for:
        if fractionalDigits < decimalPlaces then (
            f = [f, repeat(decimalPlaces - fractionalDigits, ZERO_CHAR)];
            fractionalDigits = decimalPlaces;
        );

        ##Remove digits if we have more than asked for:
        if fractionalDigits > decimalPlaces then (
            firstDigitLeftOff = f@(integerDigits + decimalPlaces + 1);
            f = f@(1 : integerDigits + decimalPlaces);
            fractionalDigits = decimalPlaces;

            #Propagate rounding if the first digit left off is greater than or equal to "5":
            if firstDigitLeftOff >= FIVE_CHAR then (
                carry = true;
                pos = columns(f);
                while carry and pos >= 1 do (
                    newChar = f@(pos) + 1;
                    if newChar > NINE_CHAR then (
                        newChar = ZERO_CHAR;
                    ) else (
                        carry = false;
                    );
                    f@(pos) = newChar;
                    pos = pos - 1;
                );
                if carry and pos == 0 then (
                    f = [ONE_CHAR, f];
                    integerDigits = integerDigits + 1;
                );
            );
        );

        #Add decimal point:
        if decimalPlaces > 0 then (
            f = [f@(1 : integerDigits), DOT_CHAR, f@(integerDigits + 1 : columns(f))];
        );

        #Add negative sign:
        if isNegative then (
            f = [MINUS_CHAR, f];
        );

        return ASCIIToString(f);
    );


    function main(args) = (
        local n, programName, count, startTime, endTime, elapsed, oldMaxDigits;

        if args == "" then (
            #Using shell variable from BASH to insert program name:
            programName = "$0";

            print("Quick and dirty single thread CPU benchmark - by JMC");
            print("Usage: ");
            print("        Pass an argument up to which prime numbers will be searched with");
            print("        an inefficient algorithm, useful to compare the single thread performance");
            print("        of the CPU");
            print("Example: ");
            print("        " + programName + " 304500");
            print("Notes: ");
            print("        Searching up to 304500 takes almost exactly 10 seconds (9.7s) on an Intel i7 4770K @ 3.5GHz");
            print("        with benchmark.c compiled without optimizations using GCC, and 8.85s with -O3.");
            print("        Genius: it takes 1820.737s (30m) using Genius 1.0.23.");
            print("                For n=3045 it takes 0.292s. For n=30450 it takes 21.438s.");
            print("");
            exit();
        );

        n = -1;
        if isStringOfDigits(args) and isNotOctal(args) then (
            n = Parse(args);
        );
        if n < 2 then (
            error("ERROR: Argument '" + args + "' not valid.");
            exit();
        );

        startTime = CurrentTime;

        count = findPrimes(n);

        endTime = CurrentTime;
        elapsed = endTime - startTime;
        print("Elapsed: " + padLeft(floatToFixed(elapsed, 3), 6) + "s");

        print(count + " prime numbers were found between 2 and " + n);
    );

    #Set variable 'args' with the arguments from the command line from BASH:
    args = "$@";
    # args = AskString("Search primes up to?");

    #Call main:
    main(args);

_EOF_
) #End of code


#Execute code in genius:
echo "$GENIUS_CODE" | genius
exit $?

